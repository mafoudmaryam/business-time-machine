# Copy this file to .env and fill in real values. .env is gitignored.

# SQLite by default. Point this at a PostgreSQL URL later, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/btm
DATABASE_URL=sqlite:///./btm.db

