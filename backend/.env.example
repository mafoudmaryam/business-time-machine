# Copy this file to .env and fill in real values. .env is gitignored.

# SQLite by default. Point this at a PostgreSQL URL later, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/btm
DATABASE_URL=sqlite:///./btm.db

# ---- AI coach (phase 4) ----
# Switch the coach on/off (turn it off for the "no coach" group of the user study).
COACH_ENABLED=true
# template = free rule-based sentences (default, also the automatic fallback)
# ollama   = local model    anthropic = Claude (needs ANTHROPIC_API_KEY)
COACH_PROVIDER=template
# Show the small "which coach is this" label in the app. Keep false for user-study participants.
COACH_SHOW_MODE=false

# Ollama (local, runs on CPU, 30 s to a few minutes per coach note)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b   # or qwen2.5:3b (faster, less careful): run `ollama pull qwen2.5:3b` first
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_NUM_PREDICT=450
# OLLAMA_NUM_CTX=4096
# OLLAMA_TIMEOUT=300

# Anthropic (only used when COACH_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-5-5
